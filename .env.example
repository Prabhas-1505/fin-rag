# PYTHONPATH wrapper (optional for local terminal running)
PYTHONPATH="${PYTHONPATH}:${PWD}"

# LLM Provider ("openai" or "groq"). Default is openai - verified live that
# the only model a standard Groq key can reach (openai/gpt-oss-120b; Llama
# requires an enterprise account) rejects this app's tool-calling requests
# over an 8,000 tokens/minute cap even on a tiny corpus, and 400s on the
# Supervisor's forced structured-output call. Flip to "groq" once you have
# real Llama 3.3 70B access - see BENCHMARK_RESULTS.md for details.
LLM_PROVIDER="openai"

# Retrieval backend ("lightweight" hashing-TFIDF+BM25, or "dense" Qdrant+cross-encoder)
RETRIEVAL_BACKEND="lightweight"

# LLM Credentials
OPENAI_API_KEY="sk-your-openai-api-key-here"
GROQ_API_KEY="gsk-your-groq-api-key-here"

# Groq model override, only used when LLM_PROVIDER=groq. Default
# (openai/gpt-oss-120b) works on standard keys but has the issues above;
# Llama models currently require an enterprise Groq account.
# GROQ_MODEL="llama-3.3-70b-versatile"

# Vector Database (Qdrant) Configuration
QDRANT_HOST="localhost"
QDRANT_PORT="6333"

# Semantic Caching (Redis) Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Relational Database (PostgreSQL) Configuration
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="admin"
POSTGRES_PASSWORD="password"
POSTGRES_DB="rag_db"

# Embedded local Qdrant mode (no Docker needed). Comment out to use QDRANT_HOST/PORT with real Qdrant server instead.
QDRANT_LOCAL_PATH=./qdrant_local_data
