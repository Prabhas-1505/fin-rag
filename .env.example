# PYTHONPATH wrapper (optional for local terminal running)
PYTHONPATH="${PYTHONPATH}:${PWD}"

# LLM Credentials
OPENAI_API_KEY="sk-your-openai-api-key-here"

# Vector Database (Qdrant) Configuration
QDRANT_HOST="localhost"
